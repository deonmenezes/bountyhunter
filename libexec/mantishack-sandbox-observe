#!/usr/bin/env python3
"""Run a command under sandbox(observe=True) and print what it touched.

Operator-friendly companion to the programmatic API:

  mantishack-sandbox-observe -- /usr/bin/true
  mantishack-sandbox-observe --json -- claude --version
  mantishack-sandbox-observe --keep --out /tmp/probe -- ./scan-target

Implemented as a shim over core.sandbox.observe_cli._cli_main rather
than `python -m core.sandbox.observe_cli` to avoid the runpy double-
import warning that fires when core/sandbox/__init__.py transitively
imports core.sandbox.observe_cli before runpy executes it as __main__.
"""
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

# ─── trust-marker check (CLAUDECODE / _MANTISHACK_TRUSTED via trust_guard) ───
from core.security.trust_guard import require_trusted_caller
require_trusted_caller()

from core.sandbox.observe_cli import _cli_main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(_cli_main())
