#!/usr/bin/env python3
"""Probe a binary under sandbox(observe=True) and cache its
filesystem + network reach for downstream allowlist consumers.

Operator surface:

  mantishack-sandbox-calibrate --bin /usr/local/bin/claude
  mantishack-sandbox-calibrate --bin /usr/local/bin/claude --json
  mantishack-sandbox-calibrate --bin /usr/local/bin/claude --show
  mantishack-sandbox-calibrate --bin /usr/local/bin/claude --force
  mantishack-sandbox-calibrate --bin /usr/local/bin/claude --clear
  mantishack-sandbox-calibrate --clear-all

Implemented as a shim over core.sandbox.calibrate_cli._cli_main
rather than `python -m core.sandbox.calibrate_cli` to avoid the
runpy double-import warning that fires when core/sandbox/__init__.py
transitively imports the module before runpy executes it as
__main__.
"""
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

# ─── trust-marker check (CLAUDECODE / _MANTISHACK_TRUSTED via trust_guard) ───
from core.security.trust_guard import require_trusted_caller
require_trusted_caller()

from core.sandbox.calibrate_cli import _cli_main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(_cli_main())
